{
  "name": "lender-orchestration-demo",
  "version": "1.0.0",
  "private": true,
  "description": "A React and Tailwind demo of resilient multi-lender orchestration",
  "scripts": {
    "dev": "concurrently -k \"node server.js\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server.js",
    "build": "vite build",
    "start": "node server.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.10",
    "vite": "^6.3.5"
  }
}
